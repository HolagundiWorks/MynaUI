<?xml version="1.0" encoding="utf-8"?>
<!--
  The accent of O-Form — Grove.
  Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText;
  SuiteOnAccent is the text/icon on a filled accent surface.
  Contrast ratios against SuiteOnAccent (#FFFFFF, WCAG 1.4.3 ≥4.5:1):
    Default  #166040 / white: 7.55:1 ✓
    Hover    #125236 / white: ~9.4:1 ✓
    Pressed  #0E422C / white: ~11.6:1 ✓
  SuiteAccentText (#166040) on white: 7.55:1 ✓
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#166040</Color>
    <Color x:Key="SuiteAccentHover">#125236</Color>
    <Color x:Key="SuiteAccentPressed">#0E422C</Color>
    <Color x:Key="SuiteAccentText">#166040</Color>
    <Color x:Key="SuiteAccentWash">#E4F0EA</Color>
    <Color x:Key="SuiteOnAccent">#FFFFFF</Color>
</ResourceDictionary>
