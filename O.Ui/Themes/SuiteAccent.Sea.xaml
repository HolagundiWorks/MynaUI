<?xml version="1.0" encoding="utf-8"?>
<!-- The accent of O-Form. Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText; SuiteOnAccent is the text on a fill. Generated by tools/make-variants.mjs. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#166040</Color>
    <Color x:Key="SuiteAccentHover">#125236</Color>
    <Color x:Key="SuiteAccentPressed">#0E422C</Color>
    <Color x:Key="SuiteAccentText">#166040</Color>
    <Color x:Key="SuiteAccentWash">#E4F0EA</Color>
    <Color x:Key="SuiteOnAccent">#FFFFFF</Color>
</ResourceDictionary>
