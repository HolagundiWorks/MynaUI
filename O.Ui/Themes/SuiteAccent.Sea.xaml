<?xml version="1.0" encoding="utf-8"?>
<!-- The accent of O-Form. Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText; SuiteOnAccent is the text on a fill. Generated by tools/make-variants.mjs. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#075056</Color>
    <Color x:Key="SuiteAccentHover">#0A6168</Color>
    <Color x:Key="SuiteAccentPressed">#0D737B</Color>
    <Color x:Key="SuiteAccentText">#075056</Color>
    <Color x:Key="SuiteAccentWash">#CFE5E7</Color>
    <Color x:Key="SuiteOnAccent">#FFFFFF</Color>
</ResourceDictionary>
