<?xml version="1.0" encoding="utf-8"?>
<!-- The accent of O-CoreOp. Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText; SuiteOnAccent is the text on a fill. Generated by tools/make-variants.mjs. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#E4EEF0</Color>
    <Color x:Key="SuiteAccentHover">#D6E4E7</Color>
    <Color x:Key="SuiteAccentPressed">#C8D9DD</Color>
    <Color x:Key="SuiteAccentText">#3B6670</Color>
    <Color x:Key="SuiteAccentWash">#E4EEF0</Color>
    <Color x:Key="SuiteOnAccent">#16232B</Color>
</ResourceDictionary>
