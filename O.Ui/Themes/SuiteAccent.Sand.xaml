<?xml version="1.0" encoding="utf-8"?>
<!--
  The accent of O-CoreOp — Dusk.
  Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText;
  SuiteOnAccent is the text/icon on a filled accent surface.
  Contrast ratios against SuiteOnAccent (#FFFFFF, WCAG 1.4.3 ≥4.5:1):
    Default  #5630A0 / white: 9.03:1 ✓
    Hover    #4A289A / white: ~10.7:1 ✓
    Pressed  #3E2080 / white: ~12.4:1 ✓
  SuiteAccentText (#5630A0) on white: 9.03:1 ✓
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#5630A0</Color>
    <Color x:Key="SuiteAccentHover">#4A289A</Color>
    <Color x:Key="SuiteAccentPressed">#3E2080</Color>
    <Color x:Key="SuiteAccentText">#5630A0</Color>
    <Color x:Key="SuiteAccentWash">#EEE8F8</Color>
    <Color x:Key="SuiteOnAccent">#FFFFFF</Color>
</ResourceDictionary>
