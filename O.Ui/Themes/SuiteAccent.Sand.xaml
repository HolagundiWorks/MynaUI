<?xml version="1.0" encoding="utf-8"?>
<!-- The accent of O-CoreOp. Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText; SuiteOnAccent is the text on a fill. Generated by tools/make-variants.mjs. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#5630A0</Color>
    <Color x:Key="SuiteAccentHover">#4A289A</Color>
    <Color x:Key="SuiteAccentPressed">#3E2080</Color>
    <Color x:Key="SuiteAccentText">#5630A0</Color>
    <Color x:Key="SuiteAccentWash">#EEE8F8</Color>
    <Color x:Key="SuiteOnAccent">#FFFFFF</Color>
</ResourceDictionary>
