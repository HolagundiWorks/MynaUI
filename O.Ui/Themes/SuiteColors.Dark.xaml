<?xml version="1.0" encoding="utf-8"?>
<!--
  Suite neutrals for the dark theme: pure black (2026-11-10). Surfaces are #000000, text is #FFFFFF; regions are told apart by edge lines.
  InkSoft #B8B8B8 is 11.5:1 on black. EdgeStrong #8C8C8C is 6.2:1 on black. Edge #3D3D3D is decoration only.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteBackground">#000000</Color>
    <Color x:Key="SuiteSidebar">#000000</Color>
    <Color x:Key="SuiteSurface">#000000</Color>
    <Color x:Key="SuiteInk">#FFFFFF</Color>
    <Color x:Key="SuiteInkSoft">#B8B8B8</Color>
    <Color x:Key="SuiteEdge">#3D3D3D</Color>
    <!-- Was #6B7280 (2.98:1 on Surface #242A36 — WCAG 1.4.11 fail). Lightened for ≥3:1. -->
    <Color x:Key="SuiteEdgeStrong">#8C8C8C</Color>
    <Color x:Key="SuiteHover">#1F1F1F</Color>
    <Color x:Key="SuiteDanger">#F87171</Color>
    <!-- The dark selection wash and the accent text are per app: SuiteAccent.<App>.Dark.xaml. -->
</ResourceDictionary>
