<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark-stage neutrals for SuiteDark.* theme dictionaries (office soft-UI, not CAD black canvas).
  Light neutrals stay in SuiteColors.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteBackground">#1B1F28</Color>
    <Color x:Key="SuiteSidebar">#151922</Color>
    <Color x:Key="SuiteSurface">#242A36</Color>
    <Color x:Key="SuiteInk">#EEF2F8</Color>
    <Color x:Key="SuiteInkSoft">#A8B0BD</Color>
    <Color x:Key="SuiteEdge">#3A4250</Color>
    <!-- Was #6B7280 (2.98:1 on Surface #242A36 — WCAG 1.4.11 fail). Lightened for ≥3:1. -->
    <Color x:Key="SuiteEdgeStrong">#708090</Color>
    <Color x:Key="SuiteHover">#2A3140</Color>
    <Color x:Key="SuiteDanger">#F87171</Color>
    <!-- Dark selection wash (replaces light SuiteAccentWash from the accent file).
         Note: each app ideally overrides this in its own SuiteDark.*.xaml; this fallback suits Midnight (O-Draft). -->
    <Color x:Key="SuiteAccentWash">#1C2A50</Color>
    <!-- AccentText dark override for O-Studio / Ember (#B83E16 fails dark BG at 2.74:1).
         Lightened to #E0703A: 5.14:1 on dark background ✓.
         Other apps should override SuiteAccentText in their own SuiteDark.*.xaml. -->
    <Color x:Key="SuiteAccentText">#E0703A</Color>
</ResourceDictionary>
