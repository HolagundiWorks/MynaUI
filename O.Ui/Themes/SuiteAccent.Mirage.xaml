<?xml version="1.0" encoding="utf-8"?>
<!--
  The accent of O-Draft — Midnight.
  Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText;
  SuiteOnAccent is the text/icon on a filled accent surface.
  Contrast ratios against SuiteOnAccent (#FFFFFF, WCAG 1.4.3 ≥4.5:1):
    Default  #102C80 / white: 12.40:1 ✓
    Hover    #0C2470 / white: ~14.5:1 ✓
    Pressed  #081C60 / white: ~17.0:1 ✓
  SuiteAccentText (#102C80) on white: 12.40:1 ✓
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#102C80</Color>
    <Color x:Key="SuiteAccentHover">#0C2470</Color>
    <Color x:Key="SuiteAccentPressed">#081C60</Color>
    <Color x:Key="SuiteAccentText">#102C80</Color>
    <Color x:Key="SuiteAccentWash">#E4E8F8</Color>
    <Color x:Key="SuiteOnAccent">#FFFFFF</Color>
</ResourceDictionary>
