<?xml version="1.0" encoding="utf-8"?>
<!-- The accent of O-Draft. Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText; SuiteOnAccent is the text on a fill. Generated by tools/make-variants.mjs. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#102C80</Color>
    <Color x:Key="SuiteAccentHover">#0C2470</Color>
    <Color x:Key="SuiteAccentPressed">#081C60</Color>
    <Color x:Key="SuiteAccentText">#102C80</Color>
    <Color x:Key="SuiteAccentWash">#E4E8F8</Color>
    <Color x:Key="SuiteOnAccent">#FFFFFF</Color>
</ResourceDictionary>
