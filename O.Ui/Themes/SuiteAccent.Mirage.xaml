<?xml version="1.0" encoding="utf-8"?>
<!-- The accent of O-Draft. Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText; SuiteOnAccent is the text on a fill. Generated by tools/make-variants.mjs. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#16232B</Color>
    <Color x:Key="SuiteAccentHover">#22343F</Color>
    <Color x:Key="SuiteAccentPressed">#2E4452</Color>
    <Color x:Key="SuiteAccentText">#16232B</Color>
    <Color x:Key="SuiteAccentWash">#D5DEE2</Color>
    <Color x:Key="SuiteOnAccent">#FFFFFF</Color>
</ResourceDictionary>
