<?xml version="1.0" encoding="utf-8"?>
<!-- The accent of O-Studio. Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText; SuiteOnAccent is the text on a fill. Generated by tools/make-variants.mjs. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#FF5B04</Color>
    <Color x:Key="SuiteAccentHover">#F25400</Color>
    <Color x:Key="SuiteAccentPressed">#E64E00</Color>
    <Color x:Key="SuiteAccentText">#A83A00</Color>
    <Color x:Key="SuiteAccentWash">#FFDFCB</Color>
    <Color x:Key="SuiteOnAccent">#16232B</Color>
</ResourceDictionary>
