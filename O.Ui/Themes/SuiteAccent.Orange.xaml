<?xml version="1.0" encoding="utf-8"?>
<!--
  The accent of O-Studio.
  Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText;
  SuiteOnAccent is the text/icon on a filled accent surface.
  All three accent fill states achieve ≥4.5:1 against SuiteOnAccent (WCAG 1.4.3):
    Default  #FF5B04 / OnAcc #16232B: 5.16:1 ✓
    Hover    #F25400 / OnAcc #16232B: 4.62:1 ✓
    Pressed  #FF4E00 / OnAcc #16232B: 4.84:1 ✓
  SuiteAccentText is for light-mode body links (6.42:1 on white ✓ 5.31:1 on BG ✓).
  Dark-mode SuiteAccentText is overridden in SuiteColors.Dark.xaml (#FF7040).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#FF5B04</Color>
    <Color x:Key="SuiteAccentHover">#F25400</Color>
    <!-- Was #E64E00 (4.17:1 vs OnAccent — WCAG 1.4.3 fail). Shifted to red-orange for ≥4.5:1. -->
    <Color x:Key="SuiteAccentPressed">#FF4E00</Color>
    <Color x:Key="SuiteAccentText">#A83A00</Color>
    <Color x:Key="SuiteAccentWash">#FFDFCB</Color>
    <Color x:Key="SuiteOnAccent">#16232B</Color>
</ResourceDictionary>
