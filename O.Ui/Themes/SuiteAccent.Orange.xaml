<?xml version="1.0" encoding="utf-8"?>
<!--
  The accent of O-Studio — Ember.
  Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText;
  SuiteOnAccent is the text/icon on a filled accent surface.
  Contrast ratios against SuiteOnAccent (#FFFFFF, WCAG 1.4.3 ≥4.5:1):
    Default  #B83E16 / white: 5.62:1 ✓
    Hover    #A03212 / white: 7.09:1 ✓
    Pressed  #8C2A10 / white: 9.13:1 ✓
  SuiteAccentText (#B83E16) on white: 5.62:1 ✓
  Dark-mode SuiteAccentText is overridden in SuiteColors.Dark.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#B83E16</Color>
    <Color x:Key="SuiteAccentHover">#A03212</Color>
    <Color x:Key="SuiteAccentPressed">#8C2A10</Color>
    <Color x:Key="SuiteAccentText">#B83E16</Color>
    <Color x:Key="SuiteAccentWash">#F8E8E0</Color>
    <Color x:Key="SuiteOnAccent">#FFFFFF</Color>
</ResourceDictionary>
