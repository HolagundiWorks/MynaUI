<?xml version="1.0" encoding="utf-8"?>
<!-- The accent of O-Studio. Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText; SuiteOnAccent is the text on a fill. Generated by tools/make-variants.mjs. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#B83E16</Color>
    <Color x:Key="SuiteAccentHover">#A03212</Color>
    <Color x:Key="SuiteAccentPressed">#8C2A10</Color>
    <Color x:Key="SuiteAccentText">#B83E16</Color>
    <Color x:Key="SuiteAccentWash">#F8E8E0</Color>
    <Color x:Key="SuiteOnAccent">#FFFFFF</Color>
</ResourceDictionary>
